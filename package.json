{
  "name": "ugc-reverse-engineer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:rules": "tsx scripts/compiler-tests.ts",
    "test:smoke": "tsx scripts/schema-smoke.ts",
    "test": "npm run typecheck && npm run test:unit && npm run test:rules && npm run test:smoke && npm run test:sql",
    "smoke": "tsx scripts/schema-smoke.ts",
    "test:sql": "python3 scripts/sql-check.py"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
